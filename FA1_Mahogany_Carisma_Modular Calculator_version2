

#:Version 2

num_1 = int(input("Enter the first number: "))
num_2 = int(input("Enter the second number: "))
operation = input("Please choose an operation (addition, subtract, multiply, divide): ").lower()


def add_numbers():
  return num_1 + num_2


def subtract_numbers():
  return num_1 - num_2


def multiply_numbers():
  return num_1 * num_2


def divide_numbers():
  if num_2 == 0:
    print("Cannot divide by zero")
    return None
  return num_1 / num_2


if operation == "addition" or operation == "add":
  answer = add_numbers()
  print("The sum is", answer)

elif operation == "subtract" or operation == "subtraction":
  answer = subtract_numbers()
  print("The difference is", answer)

elif operation == "multiply" or multiply" or operation == "multiplication":
  answer = multiply_numbers()
  print("The product is", answer)

elif operation == "divide" or operation == "division":
  answer = divide_numbers()
  print("The quotient is", answer)

else:
  print("Invalid operation chosen.")


